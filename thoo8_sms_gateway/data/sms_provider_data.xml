<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <!-- Msegat -->
    <record id="sms_provider_msegat" model="thoo8.sms.provider">
        <field name="name">Msegat</field>
        <field name="api_url">https://www.msegat.com/gw/sendsms.php</field>
        <field name="active">True</field>
        <field name="sucess_code">True</field>
        <field name="recipient_number_field">numbers</field>
        <field name="message_field">msg</field>
        <field name="success_code">1,M0000</field>
        <field name="success_code_var">code</field>
        <field name="provider_fields" eval="[
            (0, 0, {'field_name': 'username', 'api_key_name': 'userName', 'value': 'YOUR_USERNAME'}),
            (0, 0, {'field_name': 'password', 'api_key_name': 'password', 'value': 'YOUR_PASSWORD'}),
            (0, 0, {'field_name': 'sender_name', 'api_key_name': 'userSender', 'value': 'YOUR_SENDER'})
        ]"/>
        <field name="extra_params"></field>
    </record>

